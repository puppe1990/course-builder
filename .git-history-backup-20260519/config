	fetch = +refs/heads/*:refs/remotes/origin-walkinglabs/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[remote "origin"]
	url = https://github.com/puppe1990/course-builder.git
	fetch = +refs/heads/*:refs/remotes/origin/*
